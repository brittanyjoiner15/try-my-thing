# Copy to .env.local and fill in. Never commit .env.local.
# Leave the Supabase values empty to run in demo mode with fake data.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Comma-separated emails that can see /admin
ADMIN_EMAILS=brittany.j@posthog.com

# Optional: PostHog project API key for analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
